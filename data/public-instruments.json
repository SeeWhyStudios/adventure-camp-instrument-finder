    "juniorStrings": {
      "summary": "Developing note reader",
      "details": [
        "Example: read simple notes and rhythms on your instrument.",
        "Example: have experience playing short pieces with a steady pulse.",
        "The organiser must confirm any grade or tuition requirement."
      ]
    },
    "seniorStrings": {
      "summary": "Confident ensemble player",
      "details": [
        "Example: follow a part independently and keep your place in an ensemble.",
        "Example: prepare unfamiliar rhythms and changing keys with your teacher.",
        "The organiser must confirm sight-reading and technical expectations."
      ]
    },
    "juniorWind": {
      "summary": "Comfortable with simple parts",
      "details": [
        "Example: read basic rhythms and notes within a comfortable range.",
        "Example: sustain phrases with developing breath control.",
        "Required range, experience and any grade remain unconfirmed."
      ]
    },
    "seniorWind": {
      "summary": "Independent part reader",
      "details": [
        "Example: follow an individual orchestral part and count rests.",
        "Example: prepare more varied rhythms, keys and articulation.",
        "Instrument-specific range and doubling expectations need confirmation."
      ]
    },
    "juniorPercussion": {
      "summary": "Steady pulse & simple rhythms",
      "details": [
        "Example: maintain a pulse and follow a conductor's cues.",
        "Example: read simple rhythm patterns.",
        "The organiser must confirm which instruments and techniques are needed."
      ]
    },
    "seniorPercussion": {
      "summary": "Confident rhythm reading",
      "details": [
        "Example: read changing rhythms and count extended rests.",
        "Example: move between assigned percussion parts.",
        "Tuned-percussion, drum-kit and equipment requirements need confirmation."
      ]
    },
    "juniorVoice": {
      "summary": "Developing singing confidence",
      "details": [
        "Example: sing a simple melody with a steady pulse.",
        "Example: listen and match a group pitch.",
        "Junior vocal participation, experience and assessment are unconfirmed."
      ]
    },
    "seniorVoice": {
      "summary": "Comfortable singing in a group",
      "details": [
        "Example: hold a melody while listening to other voices.",
        "Example: prepare an assigned vocal line with guidance.",
        "Music reading and any audition process need confirmation."
      ]
    },
    "auxiliary": {
      "summary": "Confirm requirements",
      "details": [
        "The organisers need to confirm the skill requirements for this instrument in each camp."
      ]
    }
  },
