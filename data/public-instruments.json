        "Example: maintain a pulse and follow a conductor's cues.",
        "Example: read simple rhythm patterns.",
        "The organiser must confirm which instruments and techniques are needed."
      ]
    },
    "seniorPercussion": {
      "summary": "Confident rhythm reading",
      "details": [
        "Example: read changing rhythms and count extended rests.",
        "Example: move between assigned percussion parts.",
        "Tuned-percussion, drum-kit and equipment requirements need confirmation."
      ]
    },
    "juniorVoice": {
      "summary": "Developing singing confidence",
      "details": [
        "Example: sing a simple melody with a steady pulse.",
        "Example: listen and match a group pitch.",
        "Junior vocal participation, experience and assessment are unconfirmed."
      ]
    },
    "seniorVoice": {
      "summary": "Comfortable singing in a group",
